{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {"deploymentEnabled":{"main":false,"preview/core-v0.11.0":true}},
  "regions": ["icn1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/maintenance.js": {
      "maxDuration": 300,
      "includeFiles": "{server/partner-{ranking-parser-worker,enrichment}.mjs,node_modules/{pdf2json,read-excel-file,fflate,saxen,unzipper-esm,worker-f,graceful-fs,node-int64}/**}"
    }
  },
  "rewrites": [
    {"source":"/api/employee-directory","destination":"/api/reference-data?__reference_route=employees"},
    {"source":"/api/partner-comments","destination":"/api/reference-data?__reference_route=comments"},
    {"source":"/api/report-archives","destination":"/api/reference-data?__reference_route=archives"},
    {"source":"/api/law-search","destination":"/api/law?__law_route=search"},
    {"source":"/api/law-detail","destination":"/api/law?__law_route=detail"},
    {"source":"/api/law-watch","destination":"/api/law?__law_route=watch"},
    {"source":"/api/law-regional","destination":"/api/law?__law_route=regional"}
  ],
  "crons": [
    {"path":"/api/maintenance","schedule":"0 23 * * *"},
    {"path":"/api/maintenance?job=law&slot=morning","schedule":"0 0 * * *"},
    {"path":"/api/maintenance?job=law&slot=noon","schedule":"0 3 * * *"},
    {"path":"/api/maintenance?job=law&slot=afternoon","schedule":"0 7 * * *"},
    {"path":"/api/maintenance?job=law&slot=evening","schedule":"0 11 * * *"}
  ]
}
